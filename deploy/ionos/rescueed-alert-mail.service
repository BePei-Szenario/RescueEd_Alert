[Unit]
Description=RescueEd Alert Mail Outbox
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=rescueed-alert
Group=rescueed-alert
WorkingDirectory=/opt/rescueed-alert/current
Environment=NODE_ENV=production
EnvironmentFile=/etc/rescueed-alert/server.env
ExecStart=/usr/bin/node scripts/send-outbox.mjs
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/rescueed-alert
UMask=0077
